# BTU Scheduler configuration
# Copy to ~/.config/btu-scheduler/.env and edit values for your environment.
# Process environment variables override values in this file.

# Scheduler timing
BTU_SCHEDULER_FULL_REFRESH_INTERNAL_SECS=30
BTU_SCHEDULER_SCHEDULER_POLLING_INTERVAL=30
BTU_SCHEDULER_LOG_LEVEL=INFO
# Legacy compatibility alias:
# BTU_SCHEDULER_TRACING_LEVEL=INFO

# Connectivity mode — how BTU reaches ERPNext. See docs/technical/04-webserver-only-architecture.md.
#   direct     (default) - BTU connects to SQL and Redis directly. Requires the SQL/Redis
#                           sections below. Best when BTU runs as a sibling container in the
#                           same Docker Compose project as ERPNext (reach them by service name),
#                           or on the same host.
#   webserver  - BTU talks only to the Frappe web server over HTTP(S). No SQL/Redis
#                settings needed. Best for cross-host or managed/hosted ERPNext.
BTU_SCHEDULER_CONNECTIVITY_MODE=direct

# SQL database (Frappe) — required only when BTU_SCHEDULER_CONNECTIVITY_MODE=direct
BTU_SCHEDULER_SQL_TYPE=postgres
BTU_SCHEDULER_SQL_HOST=127.0.0.1
BTU_SCHEDULER_SQL_PORT=5432
BTU_SCHEDULER_SQL_DATABASE=your_frappe_database_name
BTU_SCHEDULER_SQL_USER=your_postgres_user
BTU_SCHEDULER_SQL_PASSWORD=your_postgres_pw

# Redis queue — required only when BTU_SCHEDULER_CONNECTIVITY_MODE=direct
BTU_SCHEDULER_RQ_HOST=127.0.0.1
BTU_SCHEDULER_RQ_PORT=11000
BTU_SCHEDULER_RQ_PASSWORD=your_rq_password

# Frappe web server — always required (both connectivity modes)
BTU_SCHEDULER_WEBSERVER_IP=127.0.0.1
BTU_SCHEDULER_WEBSERVER_PORT=8000
BTU_SCHEDULER_WEBSERVER_TOKEN=token 12345:67890
# BTU_SCHEDULER_WEBSERVER_HOST_HEADER=erp.yourcorp.com
