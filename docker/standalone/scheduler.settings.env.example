# Non-secret BTU Scheduler settings for docker/standalone/compose.yml.
BTU_SCHEDULER_CONNECTIVITY_MODE=webserver

# The Frappe web server's Compose service name (or network alias) and its internal port.
# frappe_docker stacks usually call it "backend" (port 8000); bench-style stacks often "bench".
BTU_SCHEDULER_WEBSERVER_IP=backend
BTU_SCHEDULER_WEBSERVER_PORT=8000

# The Frappe site name. Frappe picks the site from the Host header, so it must match the site's
# folder under sites/ (or a domain mapped to it).
BTU_SCHEDULER_WEBSERVER_HOST_HEADER=erp.example.com

BTU_SCHEDULER_FULL_REFRESH_INTERNAL_SECS=30
BTU_SCHEDULER_SCHEDULER_POLLING_INTERVAL=30
BTU_SCHEDULER_LOG_LEVEL=INFO
