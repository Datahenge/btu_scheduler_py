# Values substituted into docker/compose.btu-scheduler.snippet.yml.
# Copy next to the docker-compose.yml that uses the snippet, rename to `.env`
# (or merge into the stack's existing .env), and fill in the real values.

BTU_SCHEDULER_CONNECTIVITY_MODE=direct

BTU_SCHEDULER_SQL_DATABASE=your_frappe_database_name
BTU_SCHEDULER_SQL_USER=your_mariadb_user
BTU_SCHEDULER_SQL_PASSWORD=your_mariadb_password

BTU_SCHEDULER_RQ_PASSWORD=your_redis_password

BTU_SCHEDULER_WEBSERVER_IP=backend
BTU_SCHEDULER_WEBSERVER_PORT=8000
BTU_SCHEDULER_WEBSERVER_TOKEN=token your_api_key:your_api_secret
# BTU_SCHEDULER_WEBSERVER_HOST_HEADER=erp.yourcorp.com
